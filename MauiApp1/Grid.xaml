<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Grid"
             Title="Grid">
    
    <VerticalStackLayout>

        <Grid ColumnSpacing="20" >

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="auto" />
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Text="ID"/>
            <Label Grid.Column="1" Grid.Row="0" Text="Nome"/>
            <Label Grid.Column="2" Grid.Row="0" Text="Idade"/>

            <Label Grid.Column="0" Grid.Row="1" Text="1"/>
            <Label Grid.Column="1" Grid.Row="1" Text="Conradito"/>
            <Label Grid.Column="2" Grid.Row="1" Text="15"/>

            <Label Grid.Column="0" Grid.Row="2" Text="2"/>
            <Label Grid.Column="1" Grid.Row="2" Text="Helenita"/>
            <Label Grid.Column="2" Grid.Row="2" Text="30"/>

        </Grid>
        
    </VerticalStackLayout>
    
</ContentPage>